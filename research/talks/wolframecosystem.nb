Cell[TextData[{
 "I\[CloseCurlyQuote]ll make a function that takes in a set of coordinates \
and a \[OpenCurlyDoubleQuote]radius\[CloseCurlyDoubleQuote] and places one of \
these objects there, just like the \[OpenCurlyDoubleQuote]",
 StyleBox["Sphere", "Input",
  FontSize->24],
 "\[CloseCurlyDoubleQuote] command."
}], "Text",
 CellChangeTimes->{{3.8328744819077835`*^9, 3.8328745305264235`*^9}, {
  3.832874696907327*^9, 
  3.832874703190235*^9}},ExpressionUUID->"15570bdf-eb83-40ef-a33b-\
2175efbb0af2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"spikey", "[", 
   RowBox[{"center_", ",", "radius_"}], "]"}], ":=", 
  RowBox[{"TransformedRegion", "[", 
   RowBox[{
    RowBox[{"RegionResize", "[", 
     RowBox[{"rhombic", ",", 
      RowBox[{"2", "radius"}]}], "]"}], ",", 
    RowBox[{"TranslationTransform", "[", "center", "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8328745339874697`*^9, 
  3.8328746054393215`*^9}},ExpressionUUID->"a61c2bd5-b073-49a6-93b8-\
f24a29a69e6a"],

Cell["Let\[CloseCurlyQuote]s check to make sure it works:", "Text",
