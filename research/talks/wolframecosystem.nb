Cell[CellGroupData[{

Cell["ParametricPlot3D also creates parametric surfaces", "Subtitle",
 CellChangeTimes->{{3.8329295960631266`*^9, 3.8329295973815737`*^9}, {
  3.832933173283147*^9, 
  3.832933191208137*^9}},ExpressionUUID->"6f52b22f-508b-4219-ac92-\
8f3259bdb9c8"],

Cell[BoxData[
 RowBox[{"donut", "=", 
  RowBox[{"ParametricPlot3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Sin", "[", "u", "]"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"3", "+", 
         RowBox[{"Cos", "[", "v", "]"}]}], ")"}]}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Cos", "[", "u", "]"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"3", "+", 
         RowBox[{"Cos", "[", "v", "]"}]}], ")"}]}], ",", 
      RowBox[{"(", 
       RowBox[{"Sin", "[", "v", "]"}], ")"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"u", ",", "0", ",", 
      RowBox[{"2", "Pi"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"v", ",", "0", ",", 
      RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8329331946006775`*^9, 3.832933289274778*^9}, {
  3.8329333489841657`*^9, 3.8329333496546183`*^9}},
 CellLabel->
  "In[799]:=",ExpressionUUID->"ebd921de-c91b-4b15-a395-665cbebf77f0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Create a function with parameters:", "Subtitle",
 CellChangeTimes->{{3.832934069650486*^9, 
  3.832934082852488*^9}},ExpressionUUID->"561e04b5-0938-444b-9d2d-\
4255828ac2d3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"torus", "[", 
   RowBox[{"center_", ",", "outerR_", ",", "innerR_", ",", " ", 
    RowBox[{"opts", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
  RowBox[{"ParametricPlot3D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", " ", 
         RowBox[{"Sin", "[", "u", "]"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"outerR", "+", 
          RowBox[{"innerR", " ", 
           RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Cos", "[", "u", "]"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"outerR", "+", 
          RowBox[{"innerR", " ", 
           RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}]}], ",", 
       RowBox[{"(", 
        RowBox[{"innerR", " ", 
         RowBox[{"Sin", "[", "v", "]"}]}], ")"}]}], "}"}], "+", "center"}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"u", ",", "0", ",", 
      RowBox[{"2", "Pi"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"v", ",", "0", ",", 
      RowBox[{"2", "Pi"}]}], "}"}], ",", 
    RowBox[{"Mesh", "->", "None"}], ",", "opts"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8329333011569667`*^9, 3.8329333920258303`*^9}, {
   3.832933691210046*^9, 3.832933698643295*^9}, 3.8329337333309135`*^9, {
   3.832933824069373*^9, 3.8329338514055595`*^9}, {3.832933934231017*^9, 
   3.832933982729469*^9}},
 CellLabel->
  "In[818]:=",ExpressionUUID->"dba62653-e32d-413a-a925-0ab18815e873"],

Cell[BoxData[
 RowBox[{"torus", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "5", ",", ".5"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.832933366566348*^9, 3.832933383453041*^9}},
 CellLabel->
  "In[820]:=",ExpressionUUID->"bd2e3eb6-37ca-4f16-bc11-9bfd8d97ac51"],

Cell[BoxData[
 RowBox[{"torus", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "5", ",", ".5", ",", 
   RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.8329339706693687`*^9, 3.8329339740090237`*^9}},
 CellLabel->
  "In[819]:=",ExpressionUUID->"c7219e51-1854-4931-ab6e-5f15fda83cb1"],

