  3.832874639038674*^9}},ExpressionUUID->"df2a9838-7013-4a6a-8eb0-\
05c8a368e476"],

Cell[BoxData[
 RowBox[{"Graphics3D", "[", 
  RowBox[{"{", 
   RowBox[{
