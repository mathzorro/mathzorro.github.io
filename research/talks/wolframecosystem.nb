   3.832842448225012*^9},ExpressionUUID->"d7c91612-8ce5-4d77-8971-\
3b6e4416db65"],

Cell[TextData[{
 "The data is organized into Wolfram Language format.\nYou can ask a ",
 StyleBox["natural language",
  FontWeight->"Bold"],
 " question to Wolfram Alpha directly from Mathematica. \nType in ",
 StyleBox["==", "Input",
  FontSize->48],
 " and ask a question."
}], "Subtitle",
 CellChangeTimes->{{3.832841515932721*^9, 3.832841562817618*^9}, {
  3.832841642312227*^9, 3.8328417015968237`*^9}, {3.8328417536247454`*^9, 
  3.832841789183096*^9}, {3.832841893951253*^9, 
  3.8328419172979813`*^9}},ExpressionUUID->"725697c4-faf4-42f9-af88-\
f88b01aa7c8d"],

Cell["What is the weather in New York City right now?", "WolframAlphaLong",
 CellChangeTimes->{{3.8328415641103*^9, 3.83284158491104*^9}, {
  3.832843267015428*^9, 
  3.8328432716455564`*^9}},ExpressionUUID->"32bf91cf-1793-4b74-ab30-\
d4290f401ff9"],

Cell["What are the countries of the EU?", "WolframAlphaLong",
 CellChangeTimes->{{3.832841831101371*^9, 3.832841838410301*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"fb781cb6-386c-4347-b3ed-a0a7b456150a"],

Cell[BoxData[
 RowBox[{"EUcountries", "=", 
  RowBox[{"WolframAlpha", "[", 
   RowBox[{"\"\<What are the countries of the EU?\>\"", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Result\>\"", ",", "1"}], "}"}], ",", 
      "\"\<ComputableData\>\""}], "}"}], ",", 
    RowBox[{"PodStates", "\[Rule]", 
     RowBox[{"{", "\"\<Result__More\>\"", "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.8328420204645157`*^9, {3.8328420669868717`*^9, 3.8328420699415073`*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"d8cbf0a9-3882-4c73-a788-2f0e88b30322"],

Cell[CellGroupData[{

Cell["The output can then be used directly in Mathematica.", "Subtitle",
 CellChangeTimes->{{3.832841793964966*^9, 3.8328418237715487`*^9}, {
  3.832842032664951*^9, 3.832842062338236*^9}, {3.8328423958149023`*^9, 
  3.832842434629165*^9}},ExpressionUUID->"d1a8666e-3251-40cd-a9b3-\
0895c703c55b"],

Cell[TextData[StyleBox["As an example:", "Text"]], "Subtitle",
 CellChangeTimes->{{3.832841793964966*^9, 3.8328418237715487`*^9}, {
  3.832842032664951*^9, 3.832842062338236*^9}, {3.8328423958149023`*^9, 
  3.8328424360199757`*^9}},ExpressionUUID->"fb58a61b-e3cb-42fb-a7ad-\
1861060e3718"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"CountryData", "[", 
        RowBox[{"#", ",", "\"\<Name\>\""}], "]"}], ",", 
       RowBox[{"CountryData", "[", 
        RowBox[{"#", ",", "\"\<Flag\>\""}], "]"}], ",", 
       RowBox[{"CountryData", "[", 
        RowBox[{"#", ",", "\"\<GDP\>\""}], "]"}], ",", 
       RowBox[{"CountryData", "[", 
        RowBox[{"#", ",", "\"\<Area\>\""}], "]"}]}], "}"}], "&"}], ",", 
    "EUcountries"}], "]"}], " ", "//", "TableForm"}]], "Input",
 CellChangeTimes->{{3.8328420740651393`*^9, 3.8328422415953245`*^9}, {
  3.8328424146578655`*^9, 
  3.8328424174874587`*^9}},ExpressionUUID->"2863bb19-e1b5-4f9a-b8be-\
182ca0043065"]
}, Open  ]],

