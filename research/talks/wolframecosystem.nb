Cell[TextData[{
 "1. ",
 StyleBox["Import", "Input",
  FontSize->48],
 " from Thingiverse"
}], "Subtitle",
 CellChangeTimes->{{3.832747990880398*^9, 3.8327479985247974`*^9}, {
