 RowBox[{"country", "=", 
  RowBox[{"Entity", "[", 
   RowBox[{"\"\<Country\>\"", ",", "\"\<UnitedStates\>\""}], "]"}]}]], "Input",
 CellChangeTimes->{{3.832842524980748*^9, 3.8328425378038826`*^9}, {
  3.8328426516322083`*^9, 3.832842653151636*^9}},
