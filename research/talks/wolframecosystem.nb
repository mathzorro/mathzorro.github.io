Cell[CellGroupData[{

Cell["Color the faces of a polyhedron ", "Subtitle",
 CellChangeTimes->{{3.74878043452*^9, 3.748780437503207*^9}, {
  3.7487831210995293`*^9, 3.748783126987445*^9}, {3.8329365502940125`*^9, 
  3.832936566781232*^9}},ExpressionUUID->"f06958bd-5ae9-4e46-8165-\
76e702f91d58"],

Cell[BoxData[
 RowBox[{"ellipsoid", "=", 
  RowBox[{"BoundaryDiscretizeGraphics", "[", 
   RowBox[{
    RowBox[{"Ellipsoid", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"1", "/", "2"}], ",", 
        RowBox[{"1", "/", "2"}]}], "}"}]}], "]"}], ",", 
    RowBox[{"MaxCellMeasure", "\[Rule]", ".1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.83293657997554*^9, 3.832936613780692*^9}},
 CellLabel->
  "In[914]:=",ExpressionUUID->"d96431ee-4e6f-4d46-9659-410179714473"],

Cell[BoxData[
 RowBox[{
  RowBox[{"polygons", "=", 
   RowBox[{"MeshPrimitives", "[", 
    RowBox[{"ellipsoid", ",", "2"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.7487803303661137`*^9, 3.748780353164706*^9}, {
   3.7487804106556797`*^9, 3.748780413702612*^9}, 3.748782940850236*^9, {
   3.8328734416477833`*^9, 3.832873442396287*^9}, 3.8329366382586455`*^9},
 CellLabel->
  "In[917]:=",ExpressionUUID->"78a345bd-edf1-47aa-9163-5bc2d6c93179"],

Cell["Randomly:", "Text",
 CellChangeTimes->{{3.832936573026032*^9, 
  3.832936574752241*^9}},ExpressionUUID->"a8c265c6-f9fd-4a2a-b686-\
8837e9dc2071"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"colors", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Hue", "[", 
      RowBox[{"RandomReal", "[", "]"}], "]"}], ",", 
     RowBox[{"Length", "[", "polygons", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Graphics3D", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"EdgeForm", "[", "None", "]"}], ",", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"colors", ",", "polygons"}], "}"}]}], "]"}]}], "}"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.748780602933942*^9, 3.7487806524068336`*^9}, {
  3.8329221575405054`*^9, 3.8329221603508935`*^9}},
 CellLabel->
  "In[919]:=",ExpressionUUID->"c685cf0d-406f-4a70-8916-d8215f9e3fa3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"colors", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Blend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Purple", ",", "Magenta"}], "}"}], ",", 
       RowBox[{"RandomReal", "[", "]"}]}], "]"}], ",", 
     RowBox[{"Length", "[", "polygons", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Graphics3D", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"EdgeForm", "[", "None", "]"}], ",", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"colors", ",", "polygons"}], "}"}]}], "]"}]}], "}"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.8329366816308975`*^9, 3.832936717172227*^9}},
 CellLabel->
  "In[928]:=",ExpressionUUID->"cd020d7a-230c-4d7a-8651-fd84535e5a4c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Algorithmically color them based on their x-coordinate", "Subtitle",
 CellChangeTimes->{{3.748780680471418*^9, 3.748780687846883*^9}, {
  3.748780798218999*^9, 3.748780810106256*^9}, {3.748783115979231*^9, 
  3.748783132507483*^9}},ExpressionUUID->"82151834-0fcc-426d-83ea-\
0932403e0d01"],

Cell["Here is the center of the vertices of a polygon:", "Text",
 CellChangeTimes->{{3.748782963166926*^9, 
  3.748782976279324*^9}},ExpressionUUID->"85ffa7b2-8348-4d0f-90b5-\
f6223be8ff86"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Mean", "[", 
  RowBox[{"polygons", "[", 
   RowBox[{"[", 
    RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.748782958440226*^9, 3.748782973631255*^9}},
 CellLabel->
  "In[921]:=",ExpressionUUID->"2db0dec6-7b8f-4cae-885d-18ce0c33e410"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "0.1542623437338876`"}], ",", "0.4845435281647836`", ",", 
   RowBox[{"-", "0.03969162296754746`"}]}], "}"}]], "Output",
 CellChangeTimes->{3.748782977588604*^9, 3.8329366494049425`*^9},
 CellLabel->
  "Out[921]=",ExpressionUUID->"20f7fd4a-2d3c-4230-a292-537fde03f880"]
}, Open  ]],

Cell["We take the first coordinate and rescale by a factor of 3.", "Text",
 CellChangeTimes->{{3.74878298119256*^9, 
  3.748783017496467*^9}},ExpressionUUID->"8d85a149-f336-452b-b818-\
0695838ede6a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"colors", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Hue", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mean", "[", 
         RowBox[{"polygons", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "/", "3"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "polygons", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Graphics3D", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"EdgeForm", "[", "None", "]"}], ",", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"colors", ",", "polygons"}], "}"}]}], "]"}]}], "}"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.74878069664036*^9, 3.7487808960311937`*^9}, {
  3.8329221374852095`*^9, 3.8329221460296326`*^9}},
 CellLabel->
