Cell[CellGroupData[{

Cell["Useful Option: PlotPoints!", "Subtitle",
 CellChangeTimes->{{3.716638698691719*^9, 3.7166387038118935`*^9}, {
  3.8329286390251417`*^9, 
  3.8329286432313137`*^9}},ExpressionUUID->"6c3e74b9-897b-4ce5-a319-\
38556c6de352"],

Cell["\<\
That\[CloseCurlyQuote]s not nearly as smooth as we would like it, and that is \
because Mathematica is not sampling many points in the range.  We can specify \
that Mathematica should choose a certain number of points in each direction \
using the PlotPoints option.\
\>", "Text",
 CellChangeTimes->{{3.716638719178849*^9, 3.716638800271301*^9}, {
  3.727201110897931*^9, 
  3.7272011243931437`*^9}},ExpressionUUID->"d44743d3-ebbe-40e5-8e1a-\
99dbb3f09d71"],

Cell[BoxData[
 RowBox[{"block2", "=", 
  RowBox[{"RegionPlot3D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", "x", "]"}], "+", 
      RowBox[{"Sin", "[", "y", "]"}]}], ">", "z"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"0", "-", 
       RowBox[{"Pi", "/", "2"}]}], ",", 
      RowBox[{
       RowBox[{"6", "Pi"}], "-", 
       RowBox[{"Pi", "/", "2"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"0", "-", 
       RowBox[{"Pi", "/", "2"}]}], ",", 
      RowBox[{
       RowBox[{"6", "Pi"}], "-", 
       RowBox[{"Pi", "/", "2"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", 
      RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
    RowBox[{"PlotPoints", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"100", ",", "100", ",", "100"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.727201132523253*^9, 3.727201141026476*^9}, {
  3.7272011738536367`*^9, 3.72720117549979*^9}},
 CellLabel->
  "In[601]:=",ExpressionUUID->"386414cc-822d-486c-a5bc-448e9a9f01d8"],

Cell["The more precision you want, the longer it takes.", "Text",
 CellChangeTimes->{{3.8329287065228624`*^9, 
  3.8329287355689497`*^9}},ExpressionUUID->"9f983de7-8784-4ca9-822f-\
16e770ed1051"],

