Cell[CellGroupData[{

Cell["\<\
Mathematical Intermission: 2D / 3D Coordinates and Primitives\
\>", "Title",
 CellChangeTimes->{{3.8328683730078297`*^9, 3.832868380118122*^9}, {
   3.832868445117304*^9, 3.83286844776865*^9}, {3.8328684779323225`*^9, 
   3.8328684803608017`*^9}, {3.8328687951744537`*^9, 3.8328688031236467`*^9}, 
   3.8328741874423466`*^9},ExpressionUUID->"8e747506-8acd-41cc-9a13-\
736ebb6a5f06"],

Cell[TextData[{
 "We use coordinate systems to place objects (aka primitives) where we want \
them. In two dimensions, we specify a coordinate pair (x,y).\nHere we are \
using ",
 StyleBox["Disk", "Input",
  FontSize->24],
 ", which takes as input the center and radius of the circle. We wrap all the \
objects in a ",
 StyleBox["Graphics", "Input",
  FontSize->24],
 " command to display a 2D scene.\nAlso of interest are ",
 StyleBox["Line", "Input",
  FontSize->24],
 " and ",
 StyleBox["Polygon", "Input",
  FontSize->24],
 "."
}], "Text",
 CellChangeTimes->{{3.8328697973470793`*^9, 3.8328698693356066`*^9}, {
  3.8328699443089466`*^9, 3.8328699636972313`*^9}, {3.832870017196458*^9, 
  3.832870121541684*^9}, {3.8328702569122367`*^9, 
  3.832870286114193*^9}},ExpressionUUID->"5de60059-e9da-48bb-80af-\
cf5919e34632"],

Cell[BoxData[
 RowBox[{"Graphics", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"GrayLevel", "[", ".8", "]"}], ",", 
      RowBox[{"Polygon", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "2"}], "}"}]}], "}"}], "]"}], ","}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Black", ",", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], "}"}], "]"}], ","}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"Orange", ",", 
     RowBox[{"Disk", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", ".15"}], "]"}], ",", 
     "\[IndentingNewLine]", "Red", ",", 
     RowBox[{"Disk", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", ".15"}], "]"}], ",", 
     "\[IndentingNewLine]", "Magenta", ",", 
     RowBox[{"Disk", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", 
         RowBox[{"-", "1"}]}], "}"}], ",", ".15"}], "]"}], ",", 
     "\[IndentingNewLine]", "Blue", ",", 
     RowBox[{"Disk", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "2"}], "}"}], ",", ".15"}], "]"}]}], 
    "\[IndentingNewLine]", "}"}], ",", 
   RowBox[{"Axes", "\[Rule]", "True"}], ",", 
   RowBox[{"AxesOrigin", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\""}], "}"}]}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "3"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.832869639681563*^9, 3.8328697645512357`*^9}, {
  3.832869880532545*^9, 3.832869921480302*^9}, {3.832870130379031*^9, 
  3.8328702354269857`*^9}, {3.8328703029653063`*^9, 3.8328703406610637`*^9}},
 CellLabel->
  "In[281]:=",ExpressionUUID->"9f6a54e2-fdfb-455c-a635-4b5c198dfb24"],

Cell[TextData[{
 "In three dimensions, we specify a coordinate triple (x,y,z).\nHere we are \
using ",
 StyleBox["Sphere", "Input",
  FontSize->24],
 ", which takes as input the center and radius of the sphere. We wrap all the \
objects in a ",
 StyleBox["Graphics3D", "Input",
  FontSize->24],
 " command to display a 3D scene.\nAlso of interest is ",
 StyleBox["Tube", "Input",
  FontSize->24],
 "."
}], "Text",
 CellChangeTimes->{{3.8328699854569263`*^9, 3.8328700033850174`*^9}, {
  3.832870474680361*^9, 
  3.8328705295215206`*^9}},ExpressionUUID->"98c0b1ac-92a4-4cca-8b16-\
8a5e1e533cc4"],

Cell[BoxData[
 RowBox[{"graphics", "=", 
  RowBox[{"Graphics3D", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GrayLevel", "[", ".5", "]"}], ",", 
      RowBox[{"Tube", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", 
            RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "2"}], ",", "2", ",", 
            RowBox[{"-", "2"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}], ",", ".1"}], 
       "]"}], ",", "\[IndentingNewLine]", "Orange", ",", 
      RowBox[{"Sphere", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", ".25"}], "]"}], ",", 
      "\[IndentingNewLine]", "Red", ",", 
      RowBox[{"Sphere", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "2"}], "}"}], ",", ".25"}], "]"}], ",", 
      "\[IndentingNewLine]", "Magenta", ",", 
      RowBox[{"Sphere", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", 
          RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", ".25"}], "]"}], ",", 
      "\[IndentingNewLine]", "Blue", ",", 
      RowBox[{"Sphere", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2"}], ",", "2", ",", 
          RowBox[{"-", "2"}]}], "}"}], ",", ".25"}], "]"}]}], 
     "\[IndentingNewLine]", "}"}], ",", 
    RowBox[{"Axes", "\[Rule]", "True"}], ",", 
    RowBox[{"AxesOrigin", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}], ",", 
    RowBox[{"ViewVertical", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], ",", 
    RowBox[{"ViewPoint", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"3", ",", "1", ",", "1"}], "}"}]}], ",", 
    RowBox[{"SphericalRegion", "\[Rule]", "True"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "3"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.832869639681563*^9, 3.8328697645512357`*^9}, {
  3.832869880532545*^9, 3.832869921480302*^9}, {3.832870006408482*^9, 
  3.8328700098543177`*^9}, {3.832870351197589*^9, 3.832870411045683*^9}, {
  3.8328705373497076`*^9, 3.8328707049313087`*^9}, {3.8328707379476194`*^9, 
  3.8328707839089813`*^9}},
 CellLabel->
  "In[300]:=",ExpressionUUID->"6490ed35-2ba9-453f-8374-f79f324fb25a"],

