     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "1"}], "]"}], ",", 
    RowBox[{"spikey", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"3", ",", "3", ",", "3"}], "}"}], ",", "0.5"}], "]"}]}], "}"}],
   "]"}]], "Input",
 CellChangeTimes->{{3.832874608750345*^9, 3.832874642156531*^9}},
 CellLabel->
  "In[379]:=",ExpressionUUID->"675ad698-abb2-4b6b-96b2-a187fbf3b63e"],

