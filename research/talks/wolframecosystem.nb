005ae1465c05"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Column", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"KnotData", "[", 
       RowBox[{"{", 
        RowBox[{"k", ",", "m"}], "}"}], "]"}], ",", 
      RowBox[{"KnotData", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k", ",", "m"}], "}"}], ",", "p"}], "]"}]}], "}"}], "]"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "3", ",", "9", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"m", ",", "1", ",", "20", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"p", ",", 
     RowBox[{"Complement", "@@", 
      RowBox[{"KnotData", "/@", 
       RowBox[{"{", 
        RowBox[{"\"\<Properties\>\"", ",", "\"\<Classes\>\""}], "}"}]}]}]}], 
    "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.8327932946810865`*^9, 3.832793321235571*^9}, {
  3.8327933673033514`*^9, 3.832793378899284*^9}, {3.8327934142389107`*^9, 
