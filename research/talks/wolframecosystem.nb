Cell[CellGroupData[{

Cell["Recreating the constellation (3D)", "Subtitle",
 CellChangeTimes->{{3.831288232371519*^9, 3.8312882360760803`*^9}, {
  3.831288748233675*^9, 3.831288775884721*^9}, {3.832866988229251*^9, 
  3.832867006485921*^9}, {3.8328677807974463`*^9, 
  3.8328677875779257`*^9}},ExpressionUUID->"9631eb23-3f53-4e00-9988-\
02505344df0c"],

Cell[TextData[{
 "We will now make them 3D by adding in a z-component equal to zero and \
changing the ",
 StyleBox["Line", "Input",
  FontSize->24],
 " to a ",
 StyleBox["Tube", "Input",
  FontSize->24],
 "."
}], "Text",
 CellChangeTimes->{{3.83286698221863*^9, 3.832867054514776*^9}, {
  3.8328678019176383`*^9, 
  3.832867814003995*^9}},ExpressionUUID->"79712018-5881-42f6-a0e5-\
5cf642c9fcd0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"thickness", "=", "0.5"}], ";", 
  RowBox[{"convertedlines3D", "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Tube", "[", 
       RowBox[{"#", ",", "thickness"}], "]"}], "&"}], ",", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            RowBox[{"UnitConvert", "[", 
             RowBox[{
              RowBox[{"Quantity", "[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                "\"\<HoursOfRightAscension\>\""}], "]"}], ",", 
              "\"\<AngularDegrees\>\""}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "0"}], "}"}], "&"}], ",", 
       RowBox[{"constellationlines", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.8328670317965527`*^9, 3.832867083343355*^9}},
 CellLabel->
  "In[234]:=",ExpressionUUID->"9f14943f-5141-40f7-a213-903aab51a6c5"],

Cell[BoxData[
 RowBox[{"Graphics3D", "[", "convertedlines3D", "]"}]], "Input",
 CellChangeTimes->{{3.8328670412099705`*^9, 3.8328670612160516`*^9}},
 CellLabel->
  "In[235]:=",ExpressionUUID->"1ffc3ab2-fb2b-4976-8f60-aa1cbca57ea4"],

