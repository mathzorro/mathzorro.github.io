Cell[CellGroupData[{

Cell["Any location on earth", "Subtitle",
 CellChangeTimes->{{3.83293048959166*^9, 
  3.8329304991303635`*^9}},ExpressionUUID->"83057c76-4e77-41ae-9f33-\
69ce5cfc8d10"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"latitude", "=", ".20"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Latitude", " ", "window"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"longitude", "=", ".20"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Longitude", " ", "window"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"heightscale", "=", ".08"}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"Scaling", " ", "Factor", " ", "to", " ", "adjust", " ", 
    RowBox[{"height", "."}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"zoomlevel", " ", "=", " ", "11"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Start", " ", "with", " ", "a", " ", "small", " ", "zoom", " ", "level", " ", 
    RowBox[{"(", "9", ")"}], " ", "and", " ", "increase", " ", "to", " ", 
    "the", " ", "more", " ", "precise", " ", "one", " ", 
    RowBox[{
     RowBox[{"(", "11", ")"}], "."}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"center", "=", 
    RowBox[{"Entity", "[", 
     RowBox[{"\"\<City\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Pittsburgh\>\"", ",", "\"\<Pennsylvania\>\"", 
        ",", "\"\<UnitedStates\>\""}], "}"}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Or", " ", "type", " ", "\"\<Here\>\"", " ", 
    RowBox[{"(", 
     RowBox[{"without", " ", "quotes"}], ")"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"neighborhood", "=", 
   RowBox[{"GeoPolygon", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"LatitudeLongitude", "[", "center", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "+", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "latitude"}], "/", "2"}], ",", 
         RowBox[{
          RowBox[{"-", "longitude"}], "/", "2"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"LatitudeLongitude", "[", "center", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "+", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"latitude", "/", "2"}], ",", 
         RowBox[{
          RowBox[{"-", "longitude"}], "/", "2"}]}], "}"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"LatitudeLongitude", "[", "center", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "+", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"latitude", "/", "2"}], ",", 
         RowBox[{"longitude", "/", "2"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"LatitudeLongitude", "[", "center", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "+", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "latitude"}], "/", "2"}], ",", 
         RowBox[{"longitude", "/", "2"}]}], "}"}]}]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"GeoElevationData", "[", 
    RowBox[{"neighborhood", ",", "Automatic", ",", 
     RowBox[{"GeoZoomLevel", "\[Rule]", "zoomlevel"}], ",", 
     RowBox[{"UnitSystem", "\[Rule]", "\"\<Metric\>\""}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"elevation", " ", "=", 
  RowBox[{"ListPlot3D", "[", 
   RowBox[{
    RowBox[{"heightscale", " ", 
     RowBox[{"Reverse", "@", "data"}]}], ",", 
    RowBox[{"MeshFunctions", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"#3", "&"}], "}"}]}], ",", 
    RowBox[{"Mesh", "\[Rule]", "15"}], ",", 
    RowBox[{"BoxRatios", "\[Rule]", "Automatic"}], ",", 
    RowBox[{"Filling", "\[Rule]", "Bottom"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.832929411758443*^9, 3.832929421824746*^9}, {
  3.8329294764337845`*^9, 3.832929519233081*^9}, {3.8329297069640827`*^9, 
  3.832929730325185*^9}, {3.832929791232566*^9, 3.832929838726201*^9}, {
  3.832929870732903*^9, 3.832929969949849*^9}, {3.832930007605751*^9, 
  3.8329300215371513`*^9}, {3.83293007072036*^9, 3.8329301913591423`*^9}, {
  3.832930232180704*^9, 3.832930366708658*^9}, {3.8329304234270554`*^9, 
  3.8329304483283763`*^9}, {3.8329305008509007`*^9, 3.8329305939512734`*^9}, {
  3.832930972056362*^9, 3.83293099450653*^9}, {3.832946776704777*^9, 
  3.832946777005308*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"a73c5f89-ee2a-4b8b-8d42-3eac605a9848"]
