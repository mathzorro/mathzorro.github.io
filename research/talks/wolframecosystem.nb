Cell[CellGroupData[{

Cell["Plotting functions", "Title",
 CellChangeTimes->{{3.8327539318866696`*^9, 3.832753944815414*^9}, 
   3.8329264491725674`*^9},ExpressionUUID->"0fd94df2-41a0-4947-9f47-\
c2bec910a27d"],

Cell["Functions of two variables z=f(x,y)", "Subtitle",
 CellChangeTimes->{{3.8329264565305843`*^9, 
  3.8329264720307326`*^9}},ExpressionUUID->"a4c244a7-9b15-4c4a-882f-\
e246605cc5e2"],

Cell[TextData[{
 "To plot the graph of a function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", 
    RowBox[{"f", "(", 
     RowBox[{"x", ",", "y"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "22cb0356-cedf-469e-a86b-169a5385fa72"],
 ", use the ",
 StyleBox["Plot3D", "Input",
  FontSize->24],
 " command."
}], "Text",
 CellChangeTimes->{{3.716299045423217*^9, 3.716299061662983*^9}, {
  3.832937130410677*^9, 
  3.8329371311805067`*^9}},ExpressionUUID->"62785280-fdc3-43b6-aeb0-\
05d821325ce0"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "^", "2"}], "+", 
    RowBox[{"y", "^", "2"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.716299072479301*^9, 3.716299083591641*^9}, {
  3.8329265815809355`*^9, 3.832926584943308*^9}, {3.8329283893219028`*^9, 
  3.8329283919750395`*^9}},
 CellLabel->
  "In[588]:=",ExpressionUUID->"6abe2b08-5182-41b1-9f62-34d1d746e099"],

Cell[TextData[{
 "There is a hidden option called ",
 StyleBox["Extrusion", "Input",
  FontSize->24],
 " that allows you to thicken surfaces in order to be able to print them.\n\n\
Note: The scale on the z-axis is skewed relative to the x- and y-axes. Use ",
 StyleBox["BoxRatios", "Input",
  FontSize->24],
 " to make it natural."
}], "Text",
 CellChangeTimes->{{3.7166352595311327`*^9, 3.7166352653830967`*^9}, {
  3.7166353891825595`*^9, 3.716635413801431*^9}, {3.832928223877774*^9, 
  3.832928287004635*^9}, {3.832928398135312*^9, 
  3.832928410955351*^9}},ExpressionUUID->"55db759c-cda2-4647-b7e9-\
aad9ba921c9c"],

Cell[BoxData[
 RowBox[{"bowl", "=", 
  RowBox[{"Plot3D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "^", "2"}], "+", 
     RowBox[{"y", "^", "2"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
    RowBox[{"Extrusion", "\[Rule]", ".5"}], ",", 
    RowBox[{"BoxRatios", "\[Rule]", "Automatic"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7163032625423727`*^9, 3.716303267358616*^9}, {
   3.7166355057636776`*^9, 3.7166355067342577`*^9}, {3.832926622361111*^9, 
   3.8329266487242527`*^9}, {3.832928125279142*^9, 3.832928148471038*^9}, 
   3.8329282114192867`*^9},
 CellLabel->
  "In[589]:=",ExpressionUUID->"6a71face-6472-45ed-9f81-7802369db10f"],

Cell["\<\
We can use some simple math to adjust the surface.  Scale it down by a factor \
of 2 and cut off the box to have height 10.\
\>", "Text",
 CellChangeTimes->{{3.716636059768442*^9, 
  3.7166361065841684`*^9}},ExpressionUUID->"8eca3663-cb27-49ca-b398-\
3e4f8d061b98"],

Cell[BoxData[
 RowBox[{"bowl", "=", 
  RowBox[{"Plot3D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "2"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", "^", "2"}], "+", 
       RowBox[{"y", "^", "2"}]}], ")"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
    RowBox[{"Extrusion", "\[Rule]", "0.5"}], ",", 
    RowBox[{"BoxRatios", "\[Rule]", "Automatic"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "10"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"ClippingStyle", "\[Rule]", "None"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7166361096220675`*^9, 3.7166361500826607`*^9}, {
   3.8329283717687407`*^9, 3.832928384418106*^9}, 3.83292843807661*^9},
 CellLabel->
  "In[590]:=",ExpressionUUID->"7dcf8d1a-9b44-488c-8979-598068a4e557"],

Cell[BoxData[
 RowBox[{"bowlmesh", "=", 
  RowBox[{"Import", "[", 
   RowBox[{"Export", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], "<>", "\"\<bowl.stl\>\""}], 
     ",", "bowl"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7166354938522377`*^9, 3.7166355142457027`*^9}, {
