Cell[BoxData[
 RowBox[{"image", "=", 
  RowBox[{"DeleteSmallComponents", "[", 
   RowBox[{"MandelbrotSetPlot", "[", 
    RowBox[{
     RowBox[{"ColorFunction", "\[Rule]", 
