Cell[CellGroupData[{

Cell["Colors and Randomness", "Title",
 CellChangeTimes->{{3.832754008247946*^9, 3.8327540107197533`*^9}, {
  3.832873612186152*^9, 3.8328736154304852`*^9}, {3.832934046033307*^9, 
  3.8329340498536863`*^9}},ExpressionUUID->"aea12cc0-7c33-4f1e-9971-\
b6b8cb7f4f10"],

Cell["Colors", "Subtitle",
 CellChangeTimes->{{3.832935404634898*^9, 
  3.83293541780837*^9}},ExpressionUUID->"cae76b23-d852-470a-bc66-\
b0951b600282"],

Cell["\<\
Mathematica has a number of colors that can be specified by name:\
\>", "Text",
 CellChangeTimes->{{3.8329347575300083`*^9, 
  3.8329347680942*^9}},ExpressionUUID->"82ce80bb-7906-4986-99e4-f74520c491f0"],

Cell[BoxData[
 RowBox[{"namedcolors", "=", 
  RowBox[{"{", 
   RowBox[{
   "Red", ",", "Orange", ",", "Yellow", ",", "Green", ",", "Blue", ",", 
    "Purple", ",", "Pink", ",", "Magenta", ",", "Gray", ",", "White", ",", 
    "Black"}], "}"}]}]], "Input",
 CellChangeTimes->{{3.832934769682541*^9, 3.832934797918929*^9}, {
  3.8329362508360004`*^9, 3.832936252496993*^9}},
 CellLabel->
  "In[892]:=",ExpressionUUID->"3fd480eb-1e17-4fe1-9936-0343f242bf2d"],

Cell["Other colors can be made by blending colors together", "Text",
 CellChangeTimes->{{3.8329348074225206`*^9, 
  3.8329348193670855`*^9}},ExpressionUUID->"9a921333-6ad2-400d-8b51-\
2febaddd7a8f"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Blend", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Green", ",", "Blue"}], "}"}], ",", "pct"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"pct", ",", "0", ",", "1", ",", ".1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.8329348229338818`*^9, 3.832934843101227*^9}, {
  3.8329348834356337`*^9, 3.8329348877858458`*^9}},
 CellLabel->
  "In[829]:=",ExpressionUUID->"64942603-19ad-40b6-aee9-9577ea739c8f"],

Cell["Or they be grayscale", "Text",
 CellChangeTimes->{{3.8329348505925865`*^9, 
  3.832934869435541*^9}},ExpressionUUID->"0fa1087c-2fd5-40a1-8f33-\
dfcdd4cb45fe"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"GrayLevel", "[", "pct", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"pct", ",", "0", ",", "1", ",", ".1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.8329348762095385`*^9, 3.8329348930822897`*^9}},
 CellLabel->
  "In[826]:=",ExpressionUUID->"0ea70bda-a60f-489d-9f82-dcd8e8e99b05"],

Cell[TextData[{
 "Or they can be specified by a ",
 StyleBox["Hue", "Input",
  FontSize->24],
 " level"
}], "Text",
 CellChangeTimes->{{3.832934899207926*^9, 
  3.8329349072499557`*^9}},ExpressionUUID->"b4a9763b-9299-42ac-9958-\
afcf98e2f13c"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Hue", "[", "pct", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"pct", ",", "0", ",", "1", ",", ".05"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.832934911718466*^9, 3.8329349223806477`*^9}},
 CellLabel->
  "In[828]:=",ExpressionUUID->"ad3d7d8b-929c-4f1e-85cd-c5a2115e709e"],

Cell["There are also many different predefined color schemes", "Text",
 CellChangeTimes->{{3.8329349447849503`*^9, 
  3.8329349664050293`*^9}},ExpressionUUID->"4a5cc1d1-6213-4bb3-9d58-\
0c6bce7cc47d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"#", ",", 
       RowBox[{"ColorData", "[", 
        RowBox[{"#", ",", "\"\<Image\>\""}], "]"}]}], "}"}], "&"}], ",", 
