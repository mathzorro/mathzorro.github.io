    RowBox[{
     RowBox[{"EdgeForm", "[", "None", "]"}], ",", "\[IndentingNewLine]", 
     "Purple", ",", "orionmesh", ",", "\[IndentingNewLine]", "Yellow", ",", 
     RowBox[{"Map", "[", 
      RowBox[{
