  3.8328407056748734`*^9}},ExpressionUUID->"2f23bfe0-a0a4-41f1-b62f-\
9e16255ffd02"],

Cell[TextData[{
 "Consider \"https://www.thingiverse.com/thing:4864333 \".\nCopy the download \
URL. Then use ",
 StyleBox["Import", "Input",
  FontSize->24],
 ". (Put the URL in quotes.)\[LineSeparator](Use Shift-Enter to evaluate the \
cell.)\nGive the result of the importing a variable name. Here: \
\[OpenCurlyDoubleQuote]",
 StyleBox["imported", "Input",
  FontSize->24],
 "\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{3.832748111920108*^9, 3.8327481145221477`*^9}, {
   3.8327483593824434`*^9, 3.832748390170568*^9}, {3.8327484524623156`*^9, 
