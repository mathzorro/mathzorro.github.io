   RowBox[{"GeoElevationData", "[", 
    RowBox[{
     RowBox[{"GeoDisk", "[", 
      RowBox[{"everest", ",", 
       TemplateBox[{"10", "\"km\"", "kilometers", "\"Kilometers\""},
        "Quantity"]}], "]"}], ",", "Automatic", ",", "\"\<Region\>\"", ",", 
     RowBox[{"GeoZoomLevel", "\[Rule]", "11"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8329292724509706`*^9, 3.8329292726828938`*^9}, {
  3.8329293125804863`*^9, 3.832929314397865*^9}},
