Cell[TextData[{
 "Objects are broken down into different classes.\nEach object in that class \
is represented as an \[OpenCurlyDoubleQuote]",
 StyleBox["Entity", "Input",
  FontSize->24],
 "\[CloseCurlyDoubleQuote].\[LineSeparator]When evaluated it has an orange \
border; mouseover to see details."
}], "Text",
 CellChangeTimes->{{3.8328427380254235`*^9, 3.8328429352828693`*^9}, {
   3.8328429816900806`*^9, 3.8328430032036285`*^9}, 3.8328431070191574`*^9, {
   3.832843210041068*^9, 
   3.832843211638486*^9}},ExpressionUUID->"84ed5b61-5131-4da4-9873-\
ee8066d5edb3"],

