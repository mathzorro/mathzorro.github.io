Cell[CellGroupData[{

Cell["\<\
Here\[CloseCurlyQuote]s a cute technique to thicken an object. Find all \
points that are within \[CurlyEpsilon] of a region. \
\>", "Subtitle",
 CellChangeTimes->{{3.8328737573232546`*^9, 
  3.832873804398959*^9}},ExpressionUUID->"3a930cd2-507e-4779-88c7-\
8386cc2bac5a"],

Cell["\<\
(I won\[CloseCurlyQuote]t evaluate these commands because it takes a LONG \
time to compute to give a good approximation.)\
\>", "Text",
 CellChangeTimes->{{3.8328738073598833`*^9, 3.832873846005*^9}, {
  3.8328739569913397`*^9, 3.832873957746645*^9}, {3.83287401079683*^9, 
  3.832874022304276*^9}},ExpressionUUID->"bdd2b935-5bcd-4194-b7b7-\
df46ceaeb6d5"],

Cell[BoxData[
 RowBox[{"thickenedshell", "=", 
  RowBox[{"RegionPlot3D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"RegionDistance", "[", 
      RowBox[{"shell", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "<", ".02"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "1.2"}], ",", "1.2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "1.2"}], ",", "1.2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", 
      RowBox[{"-", "1.2"}], ",", "1.2"}], "}"}], ",", 
