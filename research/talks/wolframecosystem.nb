Cell[CellGroupData[{

Cell["Plotting curves", "Title",
 CellChangeTimes->{{3.727201605029842*^9, 
  3.727201607044628*^9}},ExpressionUUID->"476e402b-476e-4ccf-91d2-\
1af53f1df58d"],

Cell["A curve is really a one dimensional object", "Subtitle",
 CellChangeTimes->{{3.8329322884790893`*^9, 
  3.832932312909976*^9}},ExpressionUUID->"bafadc22-3728-448b-9157-\
8abf7b0a30c4"],

Cell[TextData[{
 "A parametric curve is when the x-coordinate and y-coordinate are defined as \
a function of an independent variable (often t).  For this type of curve, use \
",
 StyleBox["ParametricPlot", "Input",
  FontSize->24],
 ".  "
}], "Text",
 CellChangeTimes->{{3.8097855087772307`*^9, 3.809785509957935*^9}, {
  3.809787628043298*^9, 3.809787685321654*^9}, {3.8329323267361617`*^9, 
  3.8329323426979513`*^9}},ExpressionUUID->"4b945ca3-6260-4c4f-8a06-\
58613a74dcb1"],

Cell["\<\
For example, the unit circle can be written as points of the form \
(cos(x),sin(x)) as x ranges from 0 to 2\[Pi].\
\>", "Text",
 CellChangeTimes->{{3.8097876946186895`*^9, 
  3.809787736277892*^9}},ExpressionUUID->"bc4df3e7-2e26-4b69-8769-\
52884060d443"],

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", "t", "]"}], ",", 
     RowBox[{"Sin", "[", "t", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.809785485489751*^9, 3.8097854865279274`*^9}, {
  3.8329288588216205`*^9, 
  3.8329288631493616`*^9}},ExpressionUUID->"ff671907-07e0-4eb8-8e33-\
5a3c03ba8e23"],

Cell["\<\
A fun modification of these functions gives Lissajous curves:\
\>", "Text",
 CellChangeTimes->{{3.8097877447511034`*^9, 
  3.809787773039579*^9}},ExpressionUUID->"49ba54ed-9e5c-4ab8-9a6f-\
7bc75da3eb47"],

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"5", "t"}], "]"}], ",", 
     RowBox[{"Sin", "[", 
      RowBox[{"3", "t"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.8097839629721823`*^9, 3.80978397981137*^9}, {
  3.8097854735638666`*^9, 3.8097854790460653`*^9}, {3.8329288647652144`*^9, 
  3.8329288676188917`*^9}},ExpressionUUID->"99e70e3d-05b9-4527-a3c7-\
6e44e1ba2873"],

Cell["\<\
Here is a variety of graphs determined by various coefficients of x in the \
previous code.\
\>", "Text",
 CellChangeTimes->{{3.8097878355041027`*^9, 
  3.809787893701363*^9}},ExpressionUUID->"aa227896-8eb0-4159-8e07-\
30331d6f1c13"],

Cell[BoxData[
 RowBox[{"TableForm", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"ParametricPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"i", " ", "t"}], "]"}], ",", 
        RowBox[{"Sin", "[", 
         RowBox[{"j", " ", "t"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", 
        RowBox[{"2", "Pi"}]}], "}"}], ",", 
      RowBox[{"ImageSize", "\[Rule]", "100"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "5"}], "}"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.8097877783318396`*^9, 3.8097878169774675`*^9}, {
  3.832928869545829*^9, 
  3.8329288723160973`*^9}},ExpressionUUID->"837c3027-5ff9-4088-817b-\
ea0c7a3249f4"],

Cell[CellGroupData[{

Cell["In three dimensions there are three variables.", "Subtitle",
 CellChangeTimes->{{3.832932357487441*^9, 
  3.832932374615656*^9}},ExpressionUUID->"2e88c2b3-4641-4d43-910a-\
0d9b398439f7"],

Cell[TextData[{
 "The x-coordinate, y-coordinate, and z-coordinate are defined as a function \
of t. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"r", 
      RowBox[{"(", "t", ")"}]}], "=", 
     RowBox[{"<", 
      RowBox[{"x", 
       RowBox[{"(", "t", ")"}]}]}]}], ",", 
    RowBox[{"y", 
     RowBox[{"(", "t", ")"}]}], ",", 
    RowBox[{
     RowBox[{"z", "(", "t", ")"}], ">"}]}], TraditionalForm]],ExpressionUUID->
  "d91b71bc-0796-4b40-b5e1-a540fe27a912"],
 "\nUse ",
 StyleBox["ParametricPlot3D", "Input",
  FontSize->24],
 " and the option ",
 StyleBox["PlotStyle->Tube[]", "Input",
  FontSize->24],
 ".  "
}], "Text",
 CellChangeTimes->{{3.727201635222568*^9, 3.727201707040806*^9}, 
   3.727201756720091*^9, {3.8329323824925003`*^9, 
   3.8329324166350603`*^9}},ExpressionUUID->"0af38413-606d-413b-8a2d-\
20f74c4c289d"],

Cell[BoxData[
 RowBox[{"helix", "=", 
  RowBox[{"ParametricPlot3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", "t", "]"}], ",", 
      RowBox[{"Sin", "[", "t", "]"}], ",", 
      RowBox[{"t", "/", "4"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", 
      RowBox[{"4", "Pi"}]}], "}"}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"Tube", "[", ".1", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8329329233770075`*^9, 3.832932961375558*^9}, {
  3.832933089823702*^9, 
  3.8329330906415954`*^9}},ExpressionUUID->"e93c04ba-a834-4e29-8166-\
8955812bd635"],

Cell[BoxData[
 RowBox[{"Import", "[", 
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"NotebookDirectory", "[", "]"}], "<>", "\"\<helix.stl\>\""}], 
    ",", "helix"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.8329330849438*^9, 
  3.83293308791051*^9}},ExpressionUUID->"033a4387-035e-47b1-9c65-\
16a9f298dabf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Our knot from above", "Subtitle",
 CellChangeTimes->{{3.832928849217828*^9, 
  3.8329288531093316`*^9}},ExpressionUUID->"096a37c4-24f0-4e3f-945d-\
999004f8aa54"],

Cell[BoxData[
 RowBox[{"curve", "=", 
  RowBox[{"ParametricPlot3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "+", 
         RowBox[{"Cos", "[", 
          RowBox[{"4", " ", "t"}], "]"}]}], ")"}], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"3", " ", "t"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "+", 
         RowBox[{"Cos", "[", 
          RowBox[{"4", " ", "t"}], "]"}]}], ")"}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"3", " ", "t"}], "]"}]}], ",", 
      RowBox[{"Sin", "[", 
       RowBox[{"4", " ", "t"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", 
      RowBox[{"2", "Pi"}]}], "}"}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"Tube", "[", ".15", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.83293299364112*^9, 3.8329330076136885`*^9}, 
   3.8329330698153486`*^9},ExpressionUUID->"fc4a1367-b2f1-448e-b3f6-\
65c3bec21dfe"],

Cell[BoxData[
 RowBox[{"Import", "[", 
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"NotebookDirectory", "[", "]"}], "<>", "\"\<curve.stl\>\""}], 
    ",", "curve"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.8329324205420065`*^9, 3.832932430637336*^9}, 
   3.83293309416136*^9},ExpressionUUID->"73f208a3-93f6-4969-8fc9-\
8a6bd10d186f"],

Cell[TextData[{
 "Make the tube nicer by adding in ",
 StyleBox["PlotPoints", "Input",
  FontSize->24],
 " options into both the ",
 StyleBox["ParametricPlot3D", "Input",
  FontSize->24],
 " function and the ",
 StyleBox["PlotStyle", "Input",
  FontSize->24],
 " option (for the radial component)."
}], "Text",
 CellChangeTimes->{{3.72720175873575*^9, 
  3.727201858807127*^9}},ExpressionUUID->"129020f9-7c23-46ff-a5e8-\
e62554d05a00"],

Cell[BoxData[
 RowBox[{"curveHD", "=", 
  RowBox[{"ParametricPlot3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "+", 
         RowBox[{"Cos", "[", 
          RowBox[{"4", " ", "t"}], "]"}]}], ")"}], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"3", " ", "t"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "+", 
         RowBox[{"Cos", "[", 
          RowBox[{"4", " ", "t"}], "]"}]}], ")"}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"3", " ", "t"}], "]"}]}], ",", 
      RowBox[{"Sin", "[", 
       RowBox[{"4", " ", "t"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", 
      RowBox[{"2", "Pi"}]}], "}"}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"Tube", "[", 
      RowBox[{".15", ",", 
       RowBox[{"PlotPoints", "\[Rule]", "50"}]}], "]"}]}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
    RowBox[{"PlotPoints", "\[Rule]", "200"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.727201840158847*^9, 3.727201840294859*^9}, {
   3.727201891333305*^9, 3.727201891785139*^9}, {3.8329324500640693`*^9, 
   3.8329324513813677`*^9}, {3.832933034396804*^9, 3.832933054715061*^9}, 
   3.832933111399419*^9},
 CellLabel->
  "In[790]:=",ExpressionUUID->"51921e03-1719-41df-9c34-89c40077a2b3"],

Cell[BoxData[
 RowBox[{"Import", "[", 
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"NotebookDirectory", "[", "]"}], "<>", "\"\<curveHD.stl\>\""}], 
    ",", "curveHD"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.727201871746801*^9, 3.727201872239748*^9}, {
  3.8329324591938906`*^9, 3.8329324664782076`*^9}, {3.8329330972548265`*^9, 
