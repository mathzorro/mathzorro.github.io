Cell[CellGroupData[{

Cell["We can use this to create a 3D Grid:", "Subtitle",
 CellChangeTimes->{{3.8328730815930324`*^9, 3.8328730953955965`*^9}, {
  3.832873178824911*^9, 3.8328731807073383`*^9}, {3.832873278706335*^9, 
  3.8328732811081333`*^9}},ExpressionUUID->"a875dfc8-adbc-4021-a8a5-\
e79191e50e9d"],

Cell[BoxData[
 RowBox[{"grid", "=", 
  RowBox[{"Graphics3D", "[", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sphere", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", ".05"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "0", ",", "3"}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", "Bold"}], "]"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "0", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "3"}], "}"}]}], "]"}], ","}], "*)"}], 
     "\[IndentingNewLine]", "Red", ",", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Tube", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "j", ",", "k"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "j", ",", "k"}], "}"}]}], "}"}], ",", ".05"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "3"}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "Blue", ",", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Tube", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "k"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "3", ",", "k"}], "}"}]}], "}"}], ",", ".05"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "3"}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "Yellow", ",", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Tube", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i", ",", "j", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "j", ",", "3"}], "}"}]}], "}"}], ",", ".05"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "3"}], "}"}]}], "]"}], ","}], 
    "\[IndentingNewLine]", "}"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8328731694505796`*^9, 3.832873251777693*^9}},
 CellLabel->
  "In[348]:=",ExpressionUUID->"3b4936db-8a06-402d-b249-d7e039460397"],

Cell[BoxData[
 RowBox[{"Import", "[", 
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"NotebookDirectory", "[", "]"}], "<>", "\"\<grid.stl\>\""}], ",",
     "grid"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.832873199128957*^9, 3.8328732171997075`*^9}},
 CellLabel->
  "In[349]:=",ExpressionUUID->"e6d9b2a4-3802-4966-b1f6-a83935962577"],

