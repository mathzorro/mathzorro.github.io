Cell[CellGroupData[{

Cell["Randomness", "Subtitle",
 CellChangeTimes->{{3.8329354241519175`*^9, 
  3.832935425648137*^9}},ExpressionUUID->"e2c6a6be-4b4e-46c1-8d6c-\
f68fb1b9b1e1"],

Cell[TextData[{
 "To incorporate randomness, use ",
 StyleBox["RandomInteger", "Input",
  FontSize->24],
 " or ",
 StyleBox["RandomReal", "Input",
  FontSize->24],
 ". In both cases, the first input gives the range in which to choose the \
random number; a second input tells how many of such numbers to make, if more \
than one is desired."
}], "Text",
 CellChangeTimes->{{3.48043282574923*^9, 3.480433063474902*^9}, {
  3.7162987540749483`*^9, 
  3.716298800233738*^9}},ExpressionUUID->"30ff0f9c-261f-4f54-af2b-\
960351d31010"],

Cell[BoxData[{
 RowBox[{"RandomInteger", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"-", "4"}], ",", "4"}], "}"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"RandomInteger", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "10"}], "}"}], ",", "40"}], "]"}]}], "Input",
 CellChangeTimes->{{3.4801686868177233`*^9, 3.480168758299909*^9}, {
  3.716298803243332*^9, 3.716298807601987*^9}, {3.716441906934703*^9, 
  3.716441917408786*^9}, {3.716441990230482*^9, 
  3.716441995881316*^9}},ExpressionUUID->"614e5acb-dc0d-4cb7-b052-\
61bb98eb884c"],

Cell["\<\
You can even specify that you would like tuples of numbers.  Here we have \
random (x,y) coordinates with both x and y in the range [0,1].\
\>", "Text",
 CellChangeTimes->{{3.7164420210733232`*^9, 
  3.716442080526252*^9}},ExpressionUUID->"2fd61206-c990-41fd-af8c-\
7fc349e8e41e"],

Cell[BoxData[{
 RowBox[{"RandomReal", "[", "0.5", "]"}], "\[IndentingNewLine]", 
 RowBox[{"RandomReal", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "2"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.4801686868177233`*^9, 3.480168758299909*^9}, {
  3.716298803243332*^9, 3.716298807601987*^9}, {3.716441906934703*^9, 
  3.716441917408786*^9}, {3.716441990230482*^9, 
  3.716441995881316*^9}},ExpressionUUID->"fce6c406-a621-4075-83d0-\
9b8f8b02260b"],

Cell[TextData[{
 "Also of use is ",
 StyleBox["RandomChoice", "Input",
  FontSize->24],
 " and ",
 StyleBox["RandomPoint", "Input",
  FontSize->24]
}], "Text",
 CellChangeTimes->{{3.8329361712600107`*^9, 
  3.8329361800671597`*^9}},ExpressionUUID->"a1ddd3f4-a256-4752-ad0a-\
53969c61a9c2"],

