Cell["Let\[CloseCurlyQuote]s apply a color scheme to our elevation map!", \
"Text",
 CellChangeTimes->{{3.8329354897792673`*^9, 3.8329354897792673`*^9}, 
   3.832935527554804*^9, {3.8329359682934403`*^9, 
