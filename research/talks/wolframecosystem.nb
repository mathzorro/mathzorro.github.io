679da0b6d9c1"],

Cell[BoxData[
 RowBox[{"coloredelevation", " ", "=", 
  RowBox[{"ListPlot3D", "[", 
   RowBox[{
    RowBox[{"heightscale", " ", 
     RowBox[{"Reverse", "@", "data"}]}], ",", 
    RowBox[{"BoxRatios", "\[Rule]", "Automatic"}], ",", 
    RowBox[{"ColorFunction", "\[Rule]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"ColorData", "[", "\"\<GreenBrownTerrain\>\"", "]"}], "[", 
        RowBox[{".1", "+", 
         RowBox[{".9", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", "#3"}], ")"}]}]}], "]"}], "&"}], ")"}]}], ",", 
    RowBox[{"Filling", "\[Rule]", "Bottom"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.832935529659554*^9, 3.8329355622032704`*^9}, {
  3.832935622010333*^9, 3.832935630749586*^9}, {3.832935663453165*^9, 
