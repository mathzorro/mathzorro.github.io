  3.8329309639896173`*^9}},ExpressionUUID->"83361bef-3e08-4c3a-bbbb-\
72209b07b85a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"everest", "=", 
   TemplateBox[{"\"Mount Everest\"", 
     RowBox[{"Entity", "[", 
       RowBox[{"\"Mountain\"", ",", "\"MountEverest\""}], "]"}], 
     "\"Entity[\\\"Mountain\\\", \\\"MountEverest\\\"]\"", "\"mountain\""},
    "Entity"]}], ";"}]], "Input",
 CellLabel->
  "In[608]:=",ExpressionUUID->"d90b4f53-4d63-4a6b-b9a8-e15171e089e7"],

Cell[BoxData[
 RowBox[{"mountain", "=", 
