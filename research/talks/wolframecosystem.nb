   RowBox[{"{", 
    RowBox[{"p", ",", 
     RowBox[{"Complement", "@@", 
      RowBox[{"PolyhedronData", "/@", 
       RowBox[{"{", 
        RowBox[{"\"\<Properties\>\"", ",", "\"\<Classes\>\""}], "}"}]}]}]}], 
    "}"}]}], "]"}]], "Input",
