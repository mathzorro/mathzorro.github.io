Cell[CellGroupData[{

Cell["Recreating the constellation (2D)", "Subtitle",
 CellChangeTimes->{{3.831288232371519*^9, 3.8312882360760803`*^9}, {
   3.831288748233675*^9, 3.831288775884721*^9}, {3.832866988229251*^9, 
   3.832867006485921*^9}, 
   3.8328677807974463`*^9},ExpressionUUID->"b3f7bef6-10dc-4107-9841-\
d367f833bd53"],

Cell[TextData[{
 "We notice that the lines in the Constellation Graphic object are extracted \
using \[OpenCurlyDoubleQuote]",
 StyleBox["ConstellationLine", "Input",
  FontSize->24],
 "\[CloseCurlyDoubleQuote]."
}], "Text",
 CellChangeTimes->{{3.831288282901894*^9, 
  3.831288333719098*^9}},ExpressionUUID->"0c6eb5de-b787-47dc-a85b-\
cf7e746cced3"],

Cell[BoxData[
 RowBox[{"constellationlines", "=", 
  RowBox[{
   RowBox[{"Entity", "[", 
    RowBox[{"\"\<Constellation\>\"", ",", " ", "\"\<Orion\>\""}], "]"}], "[", 
   "\"\<ConstellationLine\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.8311480620840607`*^9, 3.8311480639032545`*^9}, {
  3.8312888542441893`*^9, 3.8312888553247337`*^9}, {3.831289237556906*^9, 
  3.831289239735058*^9}},
 CellLabel->
  "In[224]:=",ExpressionUUID->"9e006bcd-0ae9-43f2-9dae-4f96f1cf4626"],

Cell[BoxData[
 RowBox[{"Graphics", "[", "constellationlines", "]"}]], "Input",
 CellChangeTimes->{{3.8328668778196087`*^9, 3.8328668811579714`*^9}},
 CellLabel->
  "In[226]:=",ExpressionUUID->"bd39bd69-1b38-4b06-ae00-11dc04de0d6d"],

Cell[TextData[{
 "This is telling me there is something strange about the units of these \
coordinates. What are they? Unexpectedly to me, they are in \
\[OpenCurlyDoubleQuote]",
 StyleBox["HoursOfRightAscension", "Input",
  FontSize->24],
 "\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]",
 StyleBox["AngularDegrees", "Input",
  FontSize->24],
 "\[CloseCurlyDoubleQuote]. Let\[CloseCurlyQuote]s convert them both to \
\[OpenCurlyDoubleQuote]",
 StyleBox["AngularDegrees", "Input",
  FontSize->24],
 "\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{3.8312883356901894`*^9, 3.8312883491620846`*^9}, {
   3.831288385335394*^9, 3.8312884493115916`*^9}, {3.831288691974715*^9, 
   3.8312887253830643`*^9}, 3.831288936724967*^9, {3.832866950994233*^9, 
   3.83286695370035*^9}, {3.8328674645345583`*^9, 
   3.832867472100686*^9}},ExpressionUUID->"6a2b67bd-9851-46f8-a545-\
22d4e218f8aa"],

Cell[BoxData[
 RowBox[{"convertedlines", "=", 
  RowBox[{"Map", "[", 
   RowBox[{"Line", ",", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"UnitConvert", "[", 
            RowBox[{
             RowBox[{"Quantity", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               "\"\<HoursOfRightAscension\>\""}], "]"}], ",", 
             "\"\<AngularDegrees\>\""}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], ",", 
      RowBox[{"constellationlines", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", 
      RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]}]], "Input",
 CellLabel->
