Cell[CellGroupData[{

Cell["\<\
Queuing Model: Simulating a Waiting Room\
\>", "Subsection",
 CellChangeTimes->{{3.483203424807467*^9, 3.4832034297412233`*^9}, {
  3.4832034702803907`*^9, 3.4832034835263233`*^9}, {3.483203744623424*^9, 
  3.4832037566138897`*^9}, {3.4832039805983057`*^9, 3.4832039864620743`*^9}, {
  3.483204797347019*^9, 3.4832048222984753`*^9}},
 FontSize->24],

Cell[TextData[{
 StyleBox["Goal:",
  FontWeight->"Bold"],
 "  Understand dynamics of a waiting room\n",
 StyleBox["Idea:",
  FontWeight->"Bold"],
 " Every minute between 9am and noon a patient arrives with probability 7.5%. \
 \n          Each patient needs 15 minutes with the doctor\n",
 StyleBox["Questions:",
  FontWeight->"Bold"],
 "  How many patients are left at the end of the day?\n                    \
How much of the day is the doctor busy?\n                    What happens if \
you modify parts of the simulation?"
}], "Text",
 CellChangeTimes->{{3.483204126656312*^9, 3.4832043439917183`*^9}, {
  3.483204828748241*^9, 3.483205073384905*^9}, {3.483268047395112*^9, 
  3.4832680479943857`*^9}},
 FontSize->24],

Cell["How many patients are left at the end of the day?", "Text",
 CellChangeTimes->{{3.4832679454570827`*^9, 3.4832679560079737`*^9}},
 FontSize->36,
 FontSlant->"Italic"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"trials", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"nwait", "=", "0"}], ";", 
      RowBox[{"busy", "=", "0"}], ";", 
      RowBox[{"endTime", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "0"}], ",", 
        RowBox[{"i", "<", "180"}], ",", 
        RowBox[{"i", "++"}], ",", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"endTime", "\[Equal]", "i"}], ",", 
           RowBox[{"busy", "=", "0"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"newPatient", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"RandomReal", "[", "]"}], "\[LessEqual]", "0.075"}], ",",
             "1", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"newPatient", "\[Equal]", "1"}], ",", 
           RowBox[{"nwait", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"busy", "\[Equal]", "0"}], "&&", 
            RowBox[{"nwait", ">", "0"}]}], ",", 
           RowBox[{
            RowBox[{"nwait", "--"}], ";", 
            RowBox[{"busy", "=", "1"}], ";", 
            RowBox[{"endTime", "=", 
             RowBox[{"i", "+", "15"}]}]}]}], "]"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "nwait"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1000"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<1000-trial average:  \>\"", " ", "<>", 
   RowBox[{"ToString", "[", 
    RowBox[{"N", "[", 
     RowBox[{"Mean", "[", "trials", "]"}], "]"}], "]"}], " ", "<>", " ", 
   "\"\< patients waiting\>\""}], "]"}], "\n", 
 RowBox[{"Histogram", "[", "trials", "]"}]}], "Input",
 CellChangeTimes->{{3.483268559477076*^9, 3.483268611660696*^9}}],

Cell[BoxData["\<\"1000-trial average:  3.064 patients waiting\"\>"], "Print",
 CellChangeTimes->{{3.483268589774004*^9, 3.4832686137019672`*^9}, 
   3.484988164502245*^9}],

