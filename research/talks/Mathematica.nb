Cell[CellGroupData[{

Cell["Kempe Chain Argument in the Five-Color Theorem", "Subsection",
 CellChangeTimes->{3.483284763023778*^9},
 FontSize->24],

Cell[TextData[{
 StyleBox["Goal: ",
  FontWeight->"Bold"],
 "Prove that the vertices of every planar graph can be (properly) colored \
with five colors.\n",
 StyleBox["Problem: ",
  FontWeight->"Bold"],
 "The proof involves five colors and requires a large example. "
