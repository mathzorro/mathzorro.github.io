     RowBox[{"time", "."}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"n", "=", "1"}], ",", 
    RowBox[{"n", "\[LessEqual]", "9"}], ",", 
    RowBox[{"n", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"GG", "[", "n", "]"}], "=", 
      RowBox[{"SetGraphOptions", "[", 
       RowBox[{
        RowBox[{"AddEdges", "[", 
         RowBox[{"G", ",", 
          RowBox[{"EdgeList", "[", 
           RowBox[{"[", "n", "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"VertexLabel", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
          "8", ",", "7", ",", "6", ",", "5", ",", "4", ",", "3", ",", "2", 
           ",", "1", ",", "0", ",", "x"}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GG", "[", "n", "]"}], "=", 
      RowBox[{"SetGraphOptions", "[", 
       RowBox[{
        RowBox[{"GG", "[", "n", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"EdgeList", "[", 
              RowBox[{"[", "n", "]"}], "]"}], ",", 
             RowBox[{"EdgeColor", "\[Rule]", 
              RowBox[{"ColorList", "[", 
               RowBox[{"[", "n", "]"}], "]"}]}]}], "}"}], ",", "1"}], "]"}], 
         "}"}]}], "]"}]}]}]}], 
   RowBox[{"(*", 
    RowBox[{";", 
     RowBox[{
      RowBox[{"GG", "[", "n", "]"}], "=", 
