Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"x", "^", "3"}], "+", "5"}], ")"}]}], ",", "x"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.4834612462896833`*^9, 3.483461262612047*^9}}],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"2", " ", 
    SqrtBox["3"], " ", 
    RowBox[{"ArcTan", "[", 
     FractionBox[
      RowBox[{
       RowBox[{"-", "5"}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["5", 
         RowBox[{"2", "/", "3"}]], " ", "x"}]}], 
      RowBox[{"5", " ", 
       SqrtBox["3"]}]], "]"}]}], "+", 
   RowBox[{"2", " ", 
    RowBox[{"Log", "[", 
     RowBox[{"5", "+", 
      RowBox[{
       SuperscriptBox["5", 
        RowBox[{"2", "/", "3"}]], " ", "x"}]}], "]"}]}], "-", 
   RowBox[{"Log", "[", 
    RowBox[{"5", "-", 
     RowBox[{
      SuperscriptBox["5", 
       RowBox[{"2", "/", "3"}]], " ", "x"}], "+", 
     RowBox[{
      SuperscriptBox["5", 
       RowBox[{"1", "/", "3"}]], " ", 
      SuperscriptBox["x", "2"]}]}], "]"}]}], 
  RowBox[{"6", " ", 
   SuperscriptBox["5", 
    RowBox[{"2", "/", "3"}]]}]]], "Output",
 CellChangeTimes->{3.485008840593432*^9}]
}, Open  ]],

Cell[CellGroupData[{

