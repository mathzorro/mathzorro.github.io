Cell[CellGroupData[{

Cell["\<\
Monte Carlo Simulation: Approximation of \[Pi]\
\>", "Subsection",
 CellChangeTimes->{{3.483203424807467*^9, 3.4832034297412233`*^9}, {
  3.4832034702803907`*^9, 3.4832034835263233`*^9}, {3.483203744623424*^9, 
  3.4832037566138897`*^9}, {3.4832039805983057`*^9, 3.4832039864620743`*^9}},
 FontSize->24],

Cell[TextData[{
 StyleBox["Goal:",
  FontWeight->"Bold"],
 "  Determine the area of a unknown region.\n",
 StyleBox["Idea:",
  FontWeight->"Bold"],
 " Randomly place points in a surrounding rectangle. \n\n",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     FractionBox[
      RowBox[{"points", " ", "in", " ", "the", " ", "region"}], 
      RowBox[{"points", " ", "in", " ", "the", " ", "rectangle"}]], 
     "\[TildeTilde]", 
     FractionBox[
      RowBox[{"area", " ", "of", " ", "region"}], 
      RowBox[{"area", " ", "of", " ", "rectangle"}]]}],
    FontSize->36], TraditionalForm]],
  FormatType->"TraditionalForm",
  FontSize->24]
}], "Text",
 CellChangeTimes->{{3.483204126656312*^9, 3.4832043439917183`*^9}},
 FontSize->24],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"region", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", "-", 
         RowBox[{"x", "^", "2"}]}], "]"}], ",", 
       RowBox[{"-", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", "-", 
          RowBox[{"x", "^", "2"}]}], "]"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", 
     RowBox[{"Filling", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1", "\[Rule]", 
        RowBox[{"{", "2", "}"}]}], "}"}]}], ",", 
     RowBox[{"AspectRatio", "\[Rule]", "1"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"points", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], ",", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "5000"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dots", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"points", ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"PointSize", "\[Rule]", "Small"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{"region", ",", "dots"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"Select", "[", 
     RowBox[{"points", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], "+", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], "\[LessEqual]", 
         "1"}], ")"}], "&"}]}], "]"}], "]"}], "/", "5000."}], "*", 
  "4"}]}], "Input",
 CellChangeTimes->{{3.483203765594912*^9, 3.483203784464559*^9}, {
  3.4832038183960123`*^9, 3.483203973773385*^9}}],

