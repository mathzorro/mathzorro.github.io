Cell[TextData[{
 StyleBox["Goal: ",
  FontWeight->"Bold"],
 "Find the optimal value of linear program graphically\n",
 StyleBox["Problem:",
  FontWeight->"Bold"],
 " Difficult to understand that solution is only dependent on objective \
function.\n",
 StyleBox["Solution: ",
  FontWeight->"Bold"],
 "Create a ",
 StyleBox["Manipulate", "Input"],
 " command which allows modification of function."
}], "Text",
 CellChangeTimes->{{3.483285033860422*^9, 3.483285107981903*^9}, {
  3.483285195707106*^9, 3.483285261082506*^9}, {3.483285617397952*^9, 
  3.4832858302173147`*^9}},
 FontSize->24],

