Cell["What percentage of the day is the doctor busy?", "Text",
 CellChangeTimes->{{3.4832679454570827`*^9, 3.4832679560079737`*^9}, {
  3.483268226836067*^9, 3.4832682363031883`*^9}},
 FontSize->36,
 FontSlant->"Italic"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nwait", "=", "0"}], ";", 
  RowBox[{"busy", "=", "0"}], ";", 
  RowBox[{"endTime", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "0"}], ",", 
    RowBox[{"i", "<", "180"}], ",", 
    RowBox[{"i", "++"}], ",", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"endTime", "\[Equal]", "i"}], ",", 
       RowBox[{"busy", "=", "0"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"newPatient", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"RandomReal", "[", "]"}], "\[LessEqual]", "0.075"}], ",", 
        "1", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"newPatient", "\[Equal]", "1"}], ",", 
       RowBox[{"nwait", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"busy", "\[Equal]", "0"}], "&&", 
        RowBox[{"nwait", ">", "0"}]}], ",", 
       RowBox[{
        RowBox[{"nwait", "--"}], ";", 
        RowBox[{"busy", "=", "1"}], ";", 
        RowBox[{"endTime", "=", 
         RowBox[{"i", "+", "15"}]}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"isBusy", "[", "i", "]"}], "=", "busy"}], ";"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"busyList", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"isBusy", "[", "i", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "179"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"busyList", ",", 
   RowBox[{"PlotStyle", "\[Rule]", "Thick"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<This trial:  \>\"", " ", "<>", " ", 
    RowBox[{"ToString", "[", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Total", "[", "busyList", "]"}], "/", "180"}], "*", "100"}], 
      "]"}], "]"}], "<>", "\"\< %\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Mean", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"nwait", "=", "0"}], ";", 
     RowBox[{"busy", "=", "0"}], ";", 
     RowBox[{"endTime", "=", "0"}], ";", "\n", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "0"}], ",", 
       RowBox[{"i", "<", "180"}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"endTime", "\[Equal]", "i"}], ",", 
          RowBox[{"busy", "=", "0"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"newPatient", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"RandomReal", "[", "]"}], "\[LessEqual]", "0.075"}], ",", 
           "1", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"newPatient", "\[Equal]", "1"}], ",", 
          RowBox[{"nwait", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"busy", "\[Equal]", "0"}], "&&", 
           RowBox[{"nwait", ">", "0"}]}], ",", 
          RowBox[{
           RowBox[{"nwait", "--"}], ";", 
           RowBox[{"busy", "=", "1"}], ";", 
           RowBox[{"endTime", "=", 
            RowBox[{"i", "+", "15"}]}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"isBusy", "[", "i", "]"}], "=", "busy"}], ";"}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Total", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"isBusy", "[", "i", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "179"}], "}"}]}], "]"}], "]"}], ";"}], 
    ",", 
    RowBox[{"{", "500", "}"}]}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<100-trial avg:  \>\"", " ", "<>", " ", 
    RowBox[{"ToString", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"nwait", "=", "0"}], ";", 
           RowBox[{"busy", "=", "0"}], ";", 
           RowBox[{"endTime", "=", "0"}], ";", "\n", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "180"}], ",", 
             RowBox[{"i", "++"}], ",", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"endTime", "\[Equal]", "i"}], ",", 
                RowBox[{"busy", "=", "0"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"newPatient", "=", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"RandomReal", "[", "]"}], "\[LessEqual]", "0.075"}],
                  ",", "1", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"newPatient", "\[Equal]", "1"}], ",", 
                RowBox[{"nwait", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
              
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"busy", "\[Equal]", "0"}], "&&", 
                 RowBox[{"nwait", ">", "0"}]}], ",", 
                RowBox[{
                 RowBox[{"nwait", "--"}], ";", 
                 RowBox[{"busy", "=", "1"}], ";", 
                 RowBox[{"endTime", "=", 
                  RowBox[{"i", "+", "15"}]}]}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"isBusy", "[", "i", "]"}], "=", "busy"}], ";"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Total", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"isBusy", "[", "i", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "0", ",", "179"}], "}"}]}], "]"}], "]"}]}], 
          ",", 
          RowBox[{"{", "100", "}"}]}], "]"}], "]"}], "/", "180"}], "*", 
      "100."}], "]"}], "<>", "\"\< %\>\""}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.480071054640954*^9, 3.480071157278894*^9}, {
  3.4832682447955*^9, 3.483268475427596*^9}}],

