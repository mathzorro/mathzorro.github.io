Cell[CellGroupData[{

Cell["Graph Theory figures and animations", "Section",
 CellChangeTimes->{{3.483203210344552*^9, 3.483203221735449*^9}, {
  3.4832848066235847`*^9, 3.483284808877952*^9}},
 FontSize->36],

Cell[CellGroupData[{

Cell[TextData[{
 "Many graphs are built in to ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "."
}], "Subsection",
 CellChangeTimes->{{3.483284829816331*^9, 3.483284850423049*^9}},
 FontSize->24],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"<<", " ", "Combinatorica`"}], "\[IndentingNewLine]", 
 RowBox[{"AllG", " ", "=", 
  RowBox[{"ShowGraphArray", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "TetrahedralGraph", ",", "CubicalGraph", ",", "OctahedralGraph", ",", 
        "DodecahedralGraph", ",", "IcosahedralGraph"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"GroetzschGraph", ",", "PetersenGraph", ",", 
        RowBox[{"CompleteKPartiteGraph", "[", 
         RowBox[{"3", ",", "3"}], "]"}], ",", 
        RowBox[{"Harary", "[", 
         RowBox[{"3", ",", "8"}], "]"}], ",", 
        RowBox[{"Hypercube", "[", "4", "]"}]}], "}"}]}], "}"}], ",", 
    RowBox[{"VertexStyle", "\[Rule]", 
     RowBox[{"Disk", "[", "0.07", "]"}]}], ",", 
    RowBox[{"VertexColor", "\[Rule]", "Red"}], ",", 
    RowBox[{"EdgeStyle", "\[Rule]", "Thick"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.483284815416346*^9, 3.483284815583714*^9}, {
  3.483284884307268*^9, 3.483284933659513*^9}}],

