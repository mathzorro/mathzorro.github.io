Cell[CellGroupData[{

Cell["The \"Turning Trick\", an aide in finding graph decompositions", \
"Subsection",
 CellChangeTimes->{{3.4832849886287117`*^9, 3.4832850242356663`*^9}},
 FontSize->24],

Cell[TextData[{
 StyleBox["Goal: ",
  FontWeight->"Bold"],
 "Break down a complete graph into many copies of a smaller graph.\n",
 StyleBox["Application: ",
  FontWeight->"Bold"],
 "Finding an assignment of players to matches in a tournament.\n",
 StyleBox["Problem:",
  FontWeight->"Bold"],
 " Requires many different sets of edges, understanding the \"Turning\""
}], "Text",
 CellChangeTimes->{{3.483285033860422*^9, 3.483285107981903*^9}, {
  3.483285195707106*^9, 3.483285261082506*^9}},
 FontSize->24],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"<<", "Combinatorica`"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Create", " ", "a", " ", "graph", " ", "with", " ", "nine", " ", 
     "vertices", " ", "in", " ", "a", " ", "circle", " ", "with", " ", "one", 
     " ", "more", " ", "vertex"}], ",", " ", 
    RowBox[{"no", " ", "edges"}], ",", " ", 
    RowBox[{
    "rotated", " ", "so", " ", "that", " ", "the", " ", "last", " ", "vertex",
      " ", "is", " ", "at", " ", "the", " ", 
     RowBox[{"top", "."}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"G", "=", 
    RowBox[{"RotateVertices", "[", 
     RowBox[{
      RowBox[{"AddVertex", "[", 
       RowBox[{
        RowBox[{"EmptyGraph", "[", "9", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "0.75"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"Pi", "/", "2"}]}], "]"}]}], ";"}], "  ", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Insert", " ", "the", " ", "edges", " ", "for", " ", "each", " ", 
    RowBox[{"family", ".", "  ", "Room"}], " ", "for", " ", 
    RowBox[{"improvement", ":", "  ", 
     RowBox[{
     "there", " ", "should", " ", "be", " ", "a", " ", "better", " ", 
      "algorithm", " ", "to", " ", "generate", " ", "these", " ", "edges", 
      " ", "in", " ", "which", " ", "case", " ", "we", " ", "could", " ", 
      "change", " ", "10", " ", "to", " ", "any", " ", "other", " ", 
      "number"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EdgeList", "=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
