Cell[CellGroupData[{

Cell["Sameed Ahmed:  Where can I move?", "Subsection",
 CellChangeTimes->{{3.4834616551265306`*^9, 3.483461665957395*^9}},
 FontSize->24],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"MyPawn", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
  RowBox[{"Select", "[", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"y", "+", "i"}]}], "}"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1"}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"0", "\[LessEqual]", 
        RowBox[{"First", "[", "#", "]"}], "\[LessEqual]", "7"}], "&&", 
       RowBox[{"0", "\[LessEqual]", 
        RowBox[{"Last", "[", "#", "]"}], "\[LessEqual]", "7"}]}], ")"}], 
     "&"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"OpponentPawn", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"x", "+", "i"}], ",", 
             RowBox[{"y", "-", "i"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"x", "-", "i"}], ",", 
             RowBox[{"y", "-", "i"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1"}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"0", "\[LessEqual]", 
         RowBox[{"First", "[", "#", "]"}], "\[LessEqual]", "7"}], "&&", 
        RowBox[{"0", "\[LessEqual]", 
         RowBox[{"Last", "[", "#", "]"}], "\[LessEqual]", "7"}]}], ")"}], 
      "&"}]}], "]"}]}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Although", " ", "it", " ", "may", " ", "seem", " ", "unnecessary", " ", 
      "to", " ", "create", " ", "a", " ", "table", " ", "for", " ", 
      "\"\<Opponent Pawn\>\"", " ", "that", " ", "goes", " ", "from", " ", 
      "i"}], "=", 
     RowBox[{
     "1", " ", "to", " ", "1", " ", "when", " ", "I", " ", "could", " ", 
      "have", " ", "simply", " ", "put", " ", "\"\<y+1\>\"", " ", 
      "instead"}]}], ",", " ", 
    RowBox[{
    "I", " ", "need", " ", "to", " ", "use", " ", "Table", " ", "because", 
     " ", "it", " ", "creates", " ", "a", " ", "different", " ", "kind", " ", 
     "of", " ", "list", " ", "which", " ", "allows", " ", "for", " ", "it", 
     " ", "to", " ", "be", " ", "compared", " ", "when", " ", "using", " ", 
     RowBox[{"Compliment", ".", " ", "Also"}]}], ",", " ", 
    RowBox[{"unlike", " ", "for", " ", "other", " ", "pieces"}], ",", " ", 
    RowBox[{
    "the", " ", "pawn", " ", "is", " ", "defined", " ", "for", " ", "me", " ",
      "and", " ", "the", " ", "opponent", " ", "because", " ", "it", " ", 
     "is", " ", "the", " ", "only", " ", "piece", " ", "for", " ", "which", 
     " ", "there", " ", "are", " ", "different", " ", "movements", " ", "for",
      " ", "each", " ", 
     RowBox[{"player", ".", " ", "From"}], " ", "my", " ", "perspective"}], 
    ",", " ", 
    RowBox[{
    "my", " ", "pawn", " ", "can", " ", "only", " ", "move", " ", "up"}], ",",
     " ", 
    RowBox[{"and", " ", "my", " ", 
     RowBox[{"opponent", "'"}], "s", " ", "pawn", " ", "can", " ", "only", 
     " ", "move", " ", 
     RowBox[{"down", ".", " ", "Moreover"}]}], ",", " ", 
    RowBox[{
    "one", " ", "may", " ", "notice", " ", "that", " ", "the", " ", "two", 
     " ", "pawns", " ", "have", " ", "different", " ", 
     RowBox[{"movements", ".", " ", "This"}], " ", "is", " ", "as", " ", 
     "such", " ", "because", " ", "my", " ", "project", " ", "is", " ", 
     "only", " ", "concerned", " ", "with", " ", "not", " ", "being", " ", 
     RowBox[{"eaten", ".", " ", "Since"}], " ", "a", " ", "pawn", " ", "can", 
     " ", "only", " ", "move", " ", "forward", " ", "one", " ", "space", " ", 
     "and", " ", "only", " ", "eat", " ", "diagonally", " ", "one", " ", 
     "space"}], ",", " ", 
    RowBox[{
    "my", " ", "pawn", " ", "is", " ", "concerned", " ", "with", " ", 
     "moving", " ", "without", " ", "being", " ", "eaten"}], ",", " ", 
    RowBox[{"and", " ", "my", " ", 
     RowBox[{"opponent", "'"}], "s", " ", "pawn", " ", "is", " ", "concerned",
      " ", "with", " ", "eating", " ", "another", " ", 
     RowBox[{"piece", "."}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Rook", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
  RowBox[{"Select", "[", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x", "+", "i"}], ",", "y"}], "}"}], ",", 
