Cell[TextData[{
 StyleBox["Goal: ",
  FontWeight->"Bold"],
 "Find the intersection of a number of halfspaces. (The feasible region)\n",
 StyleBox["Problem:",
  FontWeight->"Bold"],
 " Difficult to draw all halfspaces and shading.\n",
 StyleBox["Solution: ",
  FontWeight->"Bold"],
 "Can see how adding a hyperplane chops the feasible region."
}], "Text",
